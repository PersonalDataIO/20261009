{#- ===================================================================
    Gabarit d'impression : légende, planches recto/verso, fiche animateur,
    registre des conflits. Pages A4 (210 × 297 mm), 9 cartes par planche.
=================================================================== -#}
{% import "card.html.j2" as card %}

{# ---------- Légende ---------- #}
<section class="page print-intro"><div class="doc">
  <h1>{{ cfg.titre|t }}</h1>
  <p>{{ ui.legend_intro.replace("{cards}", deck.cards|length|string).replace("{families}", deck.ordre|length|string) }}</p>
  <h2>{{ ui.walkthrough }}</h2>
  <ol>
  {% for ph in cfg.phases %}
    <li><b>{{ ph.nom }}.</b> {{ ph.texte.replace("{leviers}", cfg.leviers_pour_gagner|string)|t }}</li>
  {% endfor %}
  </ol>
  <h2>{{ ui.card_types }}</h2>
  <table class="famtab">
  {% for code in deck.ordre + ["P", "J"] %}{% set ty = types[code] %}
    <tr><td class="lt"><b>{{ ty.lettre }}</b></td>
      <td class="L">{% if ty.get("code_affiche") %}<b>{{ ty.code_affiche }}</b> · {% endif %}{{ ty.nom }}<br><span style="font-weight:400">{{ ui.level_card }} {{ levels[ty.niveau] }}</span></td>
      <td>{{ ty.description|t }}<br><i>{% if ty.tenue_par %}{{ ui.held_by }} {{ holders[ty.tenue_par]|lower }}.{% else %}{{ ui.one_per_group }}{% endif %}
        {% if ty.get("serrure") %} {{ ui.reveals_with }} {{ ty.serrure|join(" + ") }}.{% elif code == "P" %} {{ ui.bridge_reveals_with }}.{% endif %}</i></td></tr>
  {% endfor %}
  </table>
  <h2>{{ ui.families }}</h2>
  <ul class="chainlist">
  {% for s in deck.sections if s.numero is not none %}
    <li><b class="n">{{ s.key }}</b><span><b>{{ s.theme|t }}.</b> {{ s.intention|t }}</span></li>
  {% endfor %}
  </ul>
  <h2>{{ ui.printing }}</h2>
  <p>{{ cfg.impression.consigne|t }}</p>
</div></section>

{# ---------- Schéma des transitions ---------- #}
<section class="page print-intro"><div class="doc transition-map">
  <h1>{{ ui.transition_title }}</h1>
  <p class="transition-intro">{{ ui.transition_intro }}</p>
  <div class="transition-board">
    <div class="transition-lane" aria-label="{{ ui.board_aria }}">
      <div class="transition-row two-cards"><span class="transition-card"><b>T</b><small>{{ types.T.nom }}</small></span><span class="transition-card"><b>R</b><small>{{ types.R.nom }}</small></span></div>
      <span class="transition-down">↓</span>
      <div class="transition-row"><span class="transition-card key-card"><b>E</b><small>{{ types.E.nom }}</small></span></div>
      <span class="transition-down">↓</span>
      <div class="transition-row two-cards"><span class="transition-card"><b>mQc</b><small>{{ ui.mathematicians_to_drivers }}</small></span><span class="transition-card"><b>cQm</b><small>{{ ui.drivers_to_mathematicians }}</small></span></div>
      <span class="transition-down">↓</span>
      <div class="transition-row"><span class="transition-card key-card"><b>M</b><small>{{ types.M.nom }}</small></span></div>
      <span class="transition-down">↓</span>
      <div class="transition-row"><span class="transition-card key-card"><b>C</b><small>{{ types.C.nom }}</small></span></div>
      <span class="transition-down">↓</span>
      <div class="transition-row"><span class="transition-card action-card"><b>L</b><small>{{ types.L.nom }}</small></span></div>
    </div>
    <div class="transition-notes">
      <section class="transition-note"><h2>{{ ui.phase_recognize }}</h2><p>{{ ui.lived_experiences }}</p></section>
      <section class="transition-note"><h2>{{ ui.phase_explore }}</h2><p>{{ ui.questions_reveal }}</p></section>
      <section class="transition-note"><h2>{{ ui.phase_act }}</h2><p>{{ ui.constraint_lever }}</p>
        <div class="constraint-outcomes">
          {% for tri in cfg.tri_contraintes %}<div><b>{{ tri.nom }}</b><span>{{ tri.effet|t }}</span></div>{% endfor %}
        </div>
        <p>{{ ui.lever_touches_family }}</p>
        <div class="bridge-rule"><b>{{ ui.bridge }} (P)</b><span>{{ ui.bridge_unlock }}</span><b>{{ ui.false_bridge }}</b><span>{{ ui.false_bridge_rule }}</span></div>
      </section>
      <section class="transition-note"><h2>{{ ui.phase_summary }}</h2><p>{{ ui.victory_check }}</p></section>
    </div>
  </div>
</div></section>

{# ---------- Review par famille ---------- #}
{% macro review_card(c) -%}
<article class="review-card review-{{ c.type }}">
  <div class="review-card-head"><b>{{ card.display_id(c.id) }}</b><strong>{{ c.titre|t }}</strong></div>
  <p>{{ c.texte|t }}</p>
</article>
{%- endmacro %}
{% for s in deck.sections if s.numero is not none %}
{% set family = deck.section_cards(s.key) %}
{% set terrain = family|selectattr("type", "equalto", "T")|first %}
{% set recherche = family|selectattr("type", "equalto", "R")|first %}
{% set qc = family|selectattr("type", "equalto", "Qc")|first %}
{% set qm = family|selectattr("type", "equalto", "Qm")|first %}
{% set contrainte = family|selectattr("type", "equalto", "C")|first %}
{% set echo = family|selectattr("type", "equalto", "E")|first %}
{% set motif = family|selectattr("type", "equalto", "M")|first %}
{% set levier = family|selectattr("type", "equalto", "L")|first %}
<section class="page review-page"><div class="review-doc">
  <header class="review-header"><span class="review-family-number">{{ s.key }}</span><div><p>{{ ui.review_label }} {{ s.key }}</p><h1>{{ s.theme|t }}</h1><div class="review-intention">{{ s.intention|t }}</div></div></header>
  <section class="review-stage">
    <div class="review-stage-title"><b>01</b><h2>{{ ui.review_stage_1 }}</h2><span>{{ ui.two_experiences }}</span></div>
    <div class="review-flow">{{ review_card(terrain) }}<span class="review-operator">+</span>{{ review_card(recherche) }}<span class="review-operator">→</span>{{ review_card(echo) }}</div>
  </section>
  <section class="review-stage">
    <div class="review-stage-title"><b>02</b><h2>{{ ui.review_stage_2 }}</h2><span>{{ ui.each_group_asks }}</span></div>
    <div class="review-flow">{{ review_card(qc) }}<span class="review-operator">+</span>{{ review_card(qm) }}<span class="review-operator">→</span>{{ review_card(motif) }}</div>
    <p class="review-prerequisite">{{ ui.review_questions_prerequisite }}</p>
  </section>
  <section class="review-stage review-stage-final">
    <div class="review-stage-title"><b>03</b><h2>{{ ui.review_stage_3 }}</h2><span>{{ ui.constraint_sorted }}</span></div>
    <div class="review-flow">{{ review_card(motif) }}<span class="review-operator">→</span>{{ review_card(contrainte) }}<span class="review-operator">→</span>{{ review_card(levier) }}</div>
    <p class="review-prerequisite">{{ ui.review_action_prerequisite }}</p>
    <div class="review-triage">{% for tri in cfg.tri_contraintes %}<div><b>{{ tri.nom }}</b><span>{{ tri.effet|t }}</span></div>{% endfor %}</div>
  </section>
  <section class="review-moderator-notes">
    <h2>{{ ui.moderator_notes }}</h2>
    <div>{% for c in family %}<p><b>{{ card.display_id(c.id) }}</b><span>{{ c.note|t }}</span></p>{% endfor %}</div>
  </section>
  <footer class="review-footer"><b>{{ ui.victory_condition }}</b><span>{{ ui.this_lever_counts }} {{ s.key }}. {{ ui.open_at_least }} {{ cfg.leviers_pour_gagner }} {{ ui.then_reveal_issues }}</span></footer>
</div></section>
{% endfor %}

{# ---------- Planches ---------- #}
{% for sheet in deck.cards|chunks(9) %}
{% set cells = sheet + [none] * (9 - sheet|length) %}
<section class="page print-3x3"><div class="sheet grid-3x3">
  {% for c in cells %}{% if c %}<div class="cell">{{ card.recto(c) }}</div>{% else %}<div class="cell empty"></div>{% endif %}{% endfor %}
  <div class="cut-guides" aria-hidden="true"><i class="vertical v1"></i><i class="vertical v2"></i><i class="horizontal h1"></i><i class="horizontal h2"></i></div>
</div></section>
<section class="page print-3x3"><div class="sheet grid-3x3">
  {% for c in cells|mirror_rows %}{% if c %}<div class="cell">{{ card.verso(c) }}</div>{% else %}<div class="cell empty"></div>{% endif %}{% endfor %}
  <div class="cut-guides" aria-hidden="true"><i class="vertical v1"></i><i class="vertical v2"></i><i class="horizontal h1"></i><i class="horizontal h2"></i></div>
</div></section>
{% endfor %}

{% for sheet in deck.cards|chunks(4) %}
{% set cells = sheet + [none] * (4 - sheet|length) %}
<section class="page print-2x2"><div class="sheet grid-2x2">
  {% for c in cells %}{% if c %}<div class="cell">{{ card.recto(c) }}</div>{% else %}<div class="cell empty"></div>{% endif %}{% endfor %}
  <div class="cut-guides" aria-hidden="true"><i class="vertical v1"></i><i class="horizontal h1"></i></div>
</div></section>
<section class="page print-2x2"><div class="sheet grid-2x2">
  {% for c in cells|mirror_rows(2) %}{% if c %}<div class="cell">{{ card.verso(c) }}</div>{% else %}<div class="cell empty"></div>{% endif %}{% endfor %}
  <div class="cut-guides" aria-hidden="true"><i class="vertical v1"></i><i class="horizontal h1"></i></div>
</div></section>
{% endfor %}

{% for sheet in deck.cards|chunks(2) %}
{% set cells = sheet + [none] * (2 - sheet|length) %}
<section class="page print-2x1"><div class="sheet grid-2x1">
  {% for c in cells %}{% if c %}<div class="cell">{{ card.recto(c) }}</div>{% else %}<div class="cell empty"></div>{% endif %}{% endfor %}
  <div class="cut-guides" aria-hidden="true"><i class="vertical v1"></i></div>
</div></section>
<section class="page print-2x1"><div class="sheet grid-2x1">
  {% for c in cells %}{% if c %}<div class="cell rotate-back">{{ card.verso(c) }}</div>{% else %}<div class="cell empty"></div>{% endif %}{% endfor %}
  <div class="cut-guides" aria-hidden="true"><i class="vertical v1"></i></div>
</div></section>
{% endfor %}

{# ---------- Fiche animateur ---------- #}
{% for group in deck.sections|chunks(2) %}
<section class="page print-shared"><div class="doc fiche">
  {% if loop.first %}<h1 style="font-size:20pt">{{ ui.facilitator_sheet }}</h1><p>{{ ui.facilitator_intro }}</p>{% endif %}
  {% for s in group %}
  <h2><b class="n">{{ s.key }}</b>{{ s.theme|t }}</h2><p class="intent">{{ s.intention|t }}</p>
  <table class="ftab"><thead><tr><th>{{ ui.card_column }}</th><th>{{ ui.title_column }}</th><th>{{ ui.holder_column }}</th><th>{{ ui.lock_column }}</th><th>{{ ui.prompt_column }}</th></tr></thead><tbody>
  {% for c in deck.section_cards(s.key) %}
    <tr><td>{{ card.display_id(c.id) }}{% if c.a_verifier %}<br><span class="verif">{{ ui.verify_label }}</span>{% endif %}</td><td>{{ c.titre|t }}</td><td>{{ holders[c.tenue_par] }}</td>
      <td>{% if c.serrure %}{% for k in c.serrure %}{{ card.key(k) }}{{ " + " if not loop.last }}{% endfor %}{% else %}{{ ui.free_lock }}{% endif %}</td><td>{{ c.note|t }}</td></tr>
  {% endfor %}
  </tbody></table>
  {% endfor %}
</div></section>
{% endfor %}

{# ---------- Registre des conflits ---------- #}
<section class="page print-shared"><div class="doc">
  <h1 style="font-size:20pt">{{ ui.conflict_register }}</h1>
  <p>{{ ui.conflict_intro }}</p>
  <p>{% for tri in cfg.tri_contraintes %}<b>{{ tri.code }}</b> {{ tri.nom }} : {{ tri.effet|t }}.{{ " " if not loop.last }}{% endfor %}</p>
  <table class="reg"><thead><tr><th>{{ ui.conflict_card }}</th><th>{{ ui.conflict_sort }}</th><th>{{ ui.conflict_sentence }}</th><th>{{ ui.conflict_owner }}</th></tr></thead><tbody>
  {% for _ in range(cfg.impression.lignes_registre) %}
    <tr><td style="width:16mm"></td><td class="tri">{% for tri in cfg.tri_contraintes %}☐ {{ tri.code }} {% endfor %}</td><td></td><td style="width:34mm"></td></tr>
  {% endfor %}
  </tbody></table>
</div></section>
