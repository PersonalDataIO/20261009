{#- ===================================================================
    Page complète : vue Partie (interactive, static/play.js)
    + vue Impression (templates/print.html.j2). Un seul fichier autonome.
=================================================================== -#}
<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ cfg.titre }}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ cfg.favicon }}</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
{{ css }}
</style>
</head>
<body>
<div class="app">
  <div class="site-banner"><a href="https://20261009.personaldata.io/">https://20261009.personaldata.io/</a></div>
  <header class="top">
    <div class="language-row"><a class="language-switch" href="{{ language_switch_href }}" hreflang="{{ 'en' if language == 'fr' else 'fr' }}">{{ ui.language_switch }}</a></div>
    <h1>{{ cfg.titre|t }}</h1>
    <p class="lede">{{ cfg.chapeau|t }}</p>
    <ul class="nav">
    {% for s in deck.sections %}
      <li><a href="#ch-{{ s.key }}"><b>{{ s.key }}</b><span>{{ s.theme|t }}</span></a></li>
    {% endfor %}
    </ul>
    <div class="bar">
      <div class="tabs top-menus" role="group" aria-label="{{ ui.tab_group }}">
        <button type="button" id="tab-play" aria-pressed="true">{{ ui.tab_play }}</button>
        <button type="button" id="tab-print" aria-pressed="false">{{ ui.tab_print }}</button>
        <button type="button" id="tab-review" aria-pressed="false">{{ ui.tab_review }}</button>
        <button type="button" id="tab-videos" aria-pressed="false">{{ ui.tab_videos }}</button>
      </div>
      <span id="play-ctrls" class="submenu" role="group" aria-label="{{ ui.tab_play_group }}">
        <button type="button" class="ctrl" id="btn-all" aria-pressed="false">{{ ui.show_all }}</button>
        <button type="button" class="ctrl" id="btn-notes" aria-pressed="false">{{ ui.show_notes }}</button>
        <button type="button" class="ctrl" id="btn-reset">{{ ui.reset }}</button>
      </span>
      <span id="print-ctrls" class="submenu" role="group" aria-label="{{ ui.tab_print_group }}" style="display:none">
        <span id="print-formats" class="submenu">
          <button type="button" class="ctrl" id="tab-print-3x3" aria-pressed="true">{{ ui.print_3x3 }}</button>
          <button type="button" class="ctrl" id="tab-print-2x2" aria-pressed="false">{{ ui.print_2x2 }}</button>
          <button type="button" class="ctrl" id="tab-print-2x1" aria-pressed="false">{{ ui.print_2x1 }}</button>
        </span>
        <button type="button" class="ctrl primary" id="btn-print">{{ ui.print }}</button>
        <span class="hint">{{ cfg.impression.consigne|t }} {{ ui.print_help_suffix }}</span>
      </span>
      <span class="progress" id="progress"></span>
    </div>
  </header>
  <main id="play"></main>
  <main id="videos" hidden></main>
</div>
<div id="print-root" class="offscreen"><div class="pages-wrap"><div class="pages layout-3x3" id="pages">
{% include "print.html.j2" %}
</div></div></div>
<script id="deck-data" type="application/json">{{ data }}</script>
<script>
{{ js }}
</script>
</body>
</html>
